# ============================================================================
# DigiLocker Vault - Environment Variables Template
# ============================================================================
#
# This file documents all environment variables used by the application.
# Copy this file to create .env.local for local development.
#
# NEXT_PUBLIC_* variables are exposed to the browser
# Other variables are server-only and should contain sensitive values
#
# ============================================================================

# APPLICATION ENVIRONMENT
# ============================================================================

# Application environment (development | production | staging)
NEXT_PUBLIC_APP_ENV=development

# Application name (displayed in header)
NEXT_PUBLIC_APP_NAME=DigiLocker Vault

# Application URL (used for generating share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (automatically set by Next.js in production)
NODE_ENV=development


# API CONFIGURATION
# ============================================================================

# Base URL for API endpoints (use relative paths in development)
NEXT_PUBLIC_API_BASE_URL=/api

# API request timeout in milliseconds
API_TIMEOUT=30000

# Enable API logging in development
API_LOG_ENABLED=true


# CLOUD STORAGE (AWS S3 or S3-compatible)
# ============================================================================

# Storage provider: database | gcp | s3 | mock
# Use mock for local development unless you intentionally want real cloud storage.
STORAGE_PROVIDER=mock

# Google Cloud Storage (GCP) Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_STORAGE_BUCKET=your-gcs-bucket-name
GCP_CLIENT_EMAIL=digilocker-storage@your-project.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# S3 bucket name for document storage
NEXT_PUBLIC_STORAGE_BUCKET=digilocker-vault-dev

# S3 region
NEXT_PUBLIC_STORAGE_REGION=us-east-1

# S3 endpoint (for S3-compatible services like MinIO or LocalStack)
# Leave empty to use AWS S3
NEXT_PUBLIC_STORAGE_ENDPOINT=

# AWS access key ID (server-only)
STORAGE_ACCESS_KEY_ID=your-access-key-id

# AWS secret access key (server-only)
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key

# Pre-signed URL expiration time in seconds (default: 15 minutes)
PRESIGNED_URL_EXPIRY_SECONDS=900

# Enable server-side file encryption for S3
STORAGE_ENABLE_ENCRYPTION=true

# KMS key ID for S3 encryption (optional)
STORAGE_KMS_KEY_ID=


# DATABASE
# ============================================================================

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/digilocker

# Database connection pool size
DATABASE_POOL_SIZE=10

# Enable database logging
DATABASE_LOG_ENABLED=false


# AUTHENTICATION
# ============================================================================

# Enable authentication (if false, app runs without auth)
NEXT_PUBLIC_AUTH_ENABLED=false

# Secret key for JWT/session signing (generate with: openssl rand -base64 32)
AUTH_SECRET=your-super-secret-key-change-this-in-production

# Google OAuth 2.0 (server-only credentials from Google Cloud Console)
# Redirect URI for local dev: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Session expiry time in seconds (default: 24 hours)
AUTH_SESSION_EXPIRY_SECONDS=86400

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001


# FILE UPLOAD
# ============================================================================

# Maximum file size in MB (default: 10 MB per PRD)
MAX_FILE_SIZE_MB=10

# Maximum total storage per user in MB (default: 100 MB per PRD)
MAX_STORAGE_PER_USER_MB=100

# Allowed file types (comma-separated MIME types)
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/xml,application/json

# Virus scanning enabled (if false, no scanning is performed)
VIRUS_SCAN_ENABLED=false

# Virus scanning service URL (e.g., ClamAV, VirusTotal)
VIRUS_SCAN_URL=


# SHARING & LINKS
# ============================================================================

# Enable document sharing feature
NEXT_PUBLIC_ENABLE_SHARE_LINKS=true

# Default share link expiry in minutes (options: 10, 60, 1440)
NEXT_PUBLIC_DEFAULT_EXPIRY_MINUTES=60

# Maximum share link expiry in minutes
MAX_SHARE_LINK_EXPIRY_MINUTES=43200

# Enable PIN protection for share links
NEXT_PUBLIC_ENABLE_SHARE_PIN=false

# Enable view count limits for share links
NEXT_PUBLIC_ENABLE_SHARE_VIEW_LIMITS=false


# SECURITY & COMPLIANCE
# ============================================================================

# Content Security Policy enabled
CSP_ENABLED=true

# Enable CORS
CORS_ENABLED=true

# Rate limiting enabled
RATE_LIMIT_ENABLED=true

# Rate limit window in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# Rate limit max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Enable request logging
REQUEST_LOG_ENABLED=false


# MONITORING & LOGGING
# ============================================================================

# Log level (error | warn | info | debug)
LOG_LEVEL=info

# Enable error reporting (e.g., Sentry)
ERROR_REPORTING_ENABLED=false

# Error reporting DSN (e.g., Sentry DSN)
ERROR_REPORTING_DSN=

# Enable analytics
ANALYTICS_ENABLED=false

# Analytics provider token
ANALYTICS_TOKEN=


# DEVELOPMENT TOOLS (only in development)
# ============================================================================

# Enable Next.js strict mode (catches potential issues)
NEXT_PUBLIC_STRICT_MODE=true

# Enable debug logging
DEBUG=false

# Mock API responses (useful for testing without backend)
MOCK_API_ENABLED=false


# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
#
# Before deploying to production, ensure:
#
# ☐ NEXT_PUBLIC_APP_ENV=production
# ☐ NEXT_PUBLIC_APP_URL=https://your-domain.com
# ☐ NODE_ENV=production
# ☐ AUTH_SECRET is set to a strong random value
# ☐ STORAGE_ACCESS_KEY_ID and STORAGE_SECRET_ACCESS_KEY are set
# ☐ DATABASE_URL points to production database
# ☐ CORS_ALLOWED_ORIGINS includes only trusted domains
# ☐ Rate limiting is enabled
# ☐ CSP is enabled
# ☐ Error reporting is configured
# ☐ All secrets are stored in a secure vault (not in .env file)
#
# ============================================================================
