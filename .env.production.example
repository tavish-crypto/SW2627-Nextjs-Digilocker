# ============================================================================
# DigiLocker Vault - Production Environment Template
# ============================================================================
#
# This file shows recommended settings for production deployment.
# DO NOT commit this file with real secrets!
# 
# IMPORTANT: Use your deployment platform's secrets management:
# - Azure Key Vault (Azure App Service)
# - AWS Secrets Manager (AWS Lambda/EC2)
# - GitHub Secrets (GitHub Actions)
# - Vercel Environment Variables (Vercel deployment)
# - Docker secrets (Kubernetes)
#
# ============================================================================

# APPLICATION ENVIRONMENT
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=DigiLocker Vault
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NODE_ENV=production

# API CONFIGURATION
NEXT_PUBLIC_API_BASE_URL=https://your-production-domain.com/api
API_TIMEOUT=30000
API_LOG_ENABLED=false

# STORAGE
# Default/recommended for this Vercel-ready package: persist file chunks in PostgreSQL.
# No GCP/AWS credentials are required.
STORAGE_PROVIDER=database
PRESIGNED_URL_EXPIRY_SECONDS=900

# Optional: switch to Google Cloud Storage later
# STORAGE_PROVIDER=gcp
# GCP_PROJECT_ID=<your-gcp-project-id>
# GCP_STORAGE_BUCKET=<your-production-bucket>
# GCP_CLIENT_EMAIL=<service-account>@<project-id>.iam.gserviceaccount.com
# GCP_PRIVATE_KEY="<your-service-account-private-key>"

# Optional: switch to AWS S3 later
# STORAGE_PROVIDER=s3
# NEXT_PUBLIC_STORAGE_BUCKET=digilocker-vault-prod
# NEXT_PUBLIC_STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY_ID=<your-aws-access-key>
# STORAGE_SECRET_ACCESS_KEY=<your-aws-secret-key>

# DATABASE - Production Database
# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@prod-db-host:5432/digilocker_prod
# 
# Or MySQL:
# DATABASE_URL=mysql://user:password@prod-db-host:3306/digilocker_prod
# For this package on Vercel + Supabase use the Supavisor Session Pooler URL (port 5432).
# It supports the automatic Prisma schema sync used during deployment. Add connection_limit=1 if needed.
DATABASE_URL=<your-production-pooled-database-url>
DATABASE_POOL_SIZE=20
DATABASE_LOG_ENABLED=false

# AUTHENTICATION
NEXT_PUBLIC_AUTH_ENABLED=true
AUTH_SECRET=<generate-with-openssl-rand-base64-32>
AUTH_GOOGLE_ID=<your-google-client-id>
AUTH_GOOGLE_SECRET=<your-google-client-secret>
AUTH_SESSION_EXPIRY_SECONDS=86400
CORS_ALLOWED_ORIGINS=https://your-production-domain.com

# FILE UPLOAD
MAX_FILE_SIZE_MB=10
MAX_STORAGE_PER_USER_MB=100
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/xml,application/json
VIRUS_SCAN_ENABLED=true
VIRUS_SCAN_URL=https://your-clamav-or-virustotal-endpoint

# SHARING & LINKS
NEXT_PUBLIC_ENABLE_SHARE_LINKS=true
NEXT_PUBLIC_DEFAULT_EXPIRY_MINUTES=60
MAX_SHARE_LINK_EXPIRY_MINUTES=43200
NEXT_PUBLIC_ENABLE_SHARE_PIN=false
NEXT_PUBLIC_ENABLE_SHARE_VIEW_LIMITS=false

# SECURITY & COMPLIANCE
CSP_ENABLED=true
CORS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
REQUEST_LOG_ENABLED=true

# MONITORING & LOGGING
LOG_LEVEL=warn
ERROR_REPORTING_ENABLED=true
ERROR_REPORTING_DSN=<your-sentry-dsn-or-similar>
ANALYTICS_ENABLED=true
ANALYTICS_TOKEN=<your-analytics-token>

# DEVELOPMENT TOOLS (disable in production)
NEXT_PUBLIC_STRICT_MODE=false
DEBUG=false
MOCK_API_ENABLED=false

# ============================================================================
# DEPLOYMENT GUIDE
# ============================================================================
#
# 1. VERCEL (Recommended for Next.js)
#    - Go to Project Settings → Environment Variables
#    - Add all variables above (except NODE_ENV and DEBUG)
#    - Vercel automatically sets NODE_ENV=production
#
# 2. AZURE APP SERVICE
#    - Go to Configuration → Application settings
#    - Add each variable as a new setting
#    - Use Key Vault references for secrets: @Microsoft.KeyVault(...)
#
# 3. AWS AMPLIFY / LAMBDA
#    - Use AWS Secrets Manager or Parameter Store
#    - Reference in environment variables
#
# 4. DOCKER / KUBERNETES
#    - Use secrets management: docker secrets or k8s secrets
#    - Mount as environment variables in container
#
# 5. GITHUB ACTIONS (CI/CD)
#    - Use GitHub Secrets for deployment
#    - Reference as: ${{ secrets.SECRET_NAME }}
#
# ============================================================================

# GENERATING SECURE VALUES
# ============================================================================
#
# AUTH_SECRET (use openssl):
#   openssl rand -base64 32
#
# Database password (strong):
#   openssl rand -base64 24
#
# AWS keys:
#   Generate in AWS IAM console
#   Use temporary credentials (STS) if possible
#
# ============================================================================
